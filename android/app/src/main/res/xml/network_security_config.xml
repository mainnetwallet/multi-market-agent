<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Render terminates TLS with a public CA. No cleartext fallback. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
