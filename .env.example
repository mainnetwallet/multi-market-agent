# ---------------------------------------------------------------------------
# multi-market-agent example configuration. Copy to .env and edit by hand.
# PAPER is the default. LIVE requires LIVE_<VENUE>=true AND explicit human
# approval for every order (or CHAT_AUTOPILOT=true for chat-issued orders).
# Never commit .env.
# ---------------------------------------------------------------------------
APP_ENV=dev
DATABASE_URL=sqlite:///./data/mm_agent.db
HOST=127.0.0.1
PORT=8080

# Venues are enabled for scanning when listed. ACTIVE_VENUE must be ready.
ENABLED_VENUES=polymarket,kalshi,limitless
ACTIVE_VENUE=polymarket
PARALLEL_SCAN=false

# Global paper bankroll used for sizing and exposure caps. Optional per-venue
# overrides; leave blank to use BANKROLL_USD.
BANKROLL_USD=100
BANKROLL_POLYMARKET=
BANKROLL_KALSHI=
BANKROLL_LIMITLESS=
MAX_TRADE_USD=2
MAX_EVENT_PCT=4
MAX_TOTAL_EXPOSURE_PCT=15
MAX_DAILY_LOSS_PCT=5
MAX_OPEN_POSITIONS=8
ADVISORY_MODE=false

# The per-trade cap is no longer a code constant: it is a stored setting the
# operator can raise from the app with a step-up token. This is only the default
# for a fresh install; the live value lives in the hard_ceilings table.
DEFAULT_MAX_TRADE_USD=2

# --- LIVE switches (operator edits these by hand, restart required) --------
# Do not enable until scripts/doctor.py passes for that venue.
LIVE_POLYMARKET=false
LIVE_KALSHI=false
LIVE_LIMITLESS=false
# Chat-issued orders still require a human tap unless this is explicitly true.
CHAT_AUTOPILOT=false

# --- Polymarket ------------------------------------------------------------
# Polymarket account wallet address (profile -> wallet address).
POLYMARKET_WALLET_ADDRESS=
# Signer private key is read only by mm_agent.venues.polymarket_signing.
POLYMARKET_PRIVATE_KEY=
# Optional L2 CLOB credentials (created/derived by doctor.py).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_SIGNATURE_TYPE=3
# Approved for real-money doctor test only; never needed for paper.
POLYMARKET_ALLOW_REAL_TEST=false

# --- Kalshi (production) ---------------------------------------------------
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_USE_DEMO_FOR_DOCTOR=true

# --- Limitless -------------------------------------------------------------
LMTS_TOKEN_ID=
LMTS_TOKEN_SECRET=
LMTS_OWNER_ID=0
# Wallet key is read only by mm_agent.venues.limitless_signing.
LIMITLESS_PRIVATE_KEY=
LIMITLESS_API_URL=https://api.limitless.exchange
BASE_RPC_URL=https://mainnet.base.org

# --- Research (optional; without it no proposals are generated) ------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
RESEARCH_MIN_SOURCES=2
RESEARCH_MAX_AGE_MINUTES=90
LLM_ADJUSTMENT_MAX_PP=3
# Web search is required for usable research; without it, research fails closed.
TAVILY_API_KEY=
WEB_SEARCH_URL=https://api.tavily.com/search

# --- Control API / PWA -----------------------------------------------------
ADMIN_USERNAME=operator
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=change-me-to-a-long-random-stable-string
SESSION_TTL_HOURS=72
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Telegram (optional) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=0
TELEGRAM_HEARTBEAT_SECONDS=21600

# --- scanner / feeds -------------------------------------------------------
SCAN_INTERVAL_SECONDS=60
MARKETS_PER_SCAN=40
BOOK_FEED_MARKETS=5
BOOK_FEED_INTERVAL_SECONDS=5
BOOK_FRESH_SECONDS=30
PROPOSAL_TTL_SECONDS=300
AUTO_PROPOSE=true
PROPOSALS_PER_CYCLE=2

# --- Funds module ----------------------------------------------------------
# OFF by default. The funds routes move real money and are disabled unless this
# is true. The funds signer is a SEPARATE key from every trading key: it must
# never be a key the trading code can reach, and it must not be a key with
# withdrawal permission on a trading venue.
FUNDS_ENABLED=false
# Funds signer key. Only mm_agent.funds reads it.
FUNDS_SIGNER_PRIVATE_KEY=
# The address that receives funds on venues with no deposit API (Limitless).
FUNDS_SIGNER_ADDRESS=
# RPC used by the funds signer.
FUNDS_RPC_URL=https://mainnet.base.org
# Polymarket Relayer API key (gasless redeem/split/merge). Optional; without it
# those routes report supported:false rather than pretending to work.
FUNDS_RELAYER_API_KEY=
FUNDS_RELAYER_API_KEY_ADDRESS=
# Polymarket Bridge. The builder code is optional; without it the bridge
# returns a missing_builder_code warning but still works.
FUNDS_POLYMARKET_BRIDGE_URL=https://bridge.polymarket.com
FUNDS_POLYMARKET_BUILDER_CODE=
# Server-side withdrawal limits. Raising them from the app needs a step-up token.
FUNDS_WITHDRAWAL_DAILY_LIMIT_USD=25
FUNDS_WITHDRAWAL_HOLD_MINUTES=10
# A new allowlisted address waits this long before it can be used. 0 with a
# step-up token if you want to skip the wait.
FUNDS_ALLOWLIST_COOLING_HOURS=24
